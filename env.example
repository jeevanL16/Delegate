# =========================
# LLM (pick ONE provider)
# =========================
LLM_PROVIDER=groq
GROQ_API_KEY=                      # get free at console.groq.com/keys
GEMINI_API_KEY=                    # only if LLM_PROVIDER=gemini, get at aistudio.google.com
LLM_MODEL=llama-3.3-70b-versatile

# =========================
# Database
# =========================
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/delegate

# =========================
# Auth
# =========================
SERVICE_API_KEY=                   # generate: openssl rand -hex 16
HUMAN_JWT_SECRET=                  # generate: openssl rand -hex 32
CORS_ORIGINS=http://localhost:8501

# =========================
# Policy (server-enforced caps)
# =========================
REFUND_CAP_CENTS=100000
MAX_TOOL_CALLS_PER_TICKET=5
MAX_REFUNDS_PER_TICKET=1

# =========================
# n8n — outbound notification webhook
# =========================
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/delegate-notify
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret
                                    # header name to send this as: X-Delegate-Secret

# =========================
# Cognee — ticket memory
# =========================
COGNEE_LLM_PROVIDER=groq
COGNEE_LLM_API_KEY=                # can reuse the same value as GROQ_API_KEY above
COGNEE_LLM_MODEL=llama-3.3-70b-versatile

# =========================
# Misc
# =========================
LOG_LEVEL=INFO
ENVIRONMENT=development
