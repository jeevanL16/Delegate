# ==============================================================================
# Delegate: Resolve — Environment Configuration Example
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# ── LLM (pick one provider — set LLM_PROVIDER accordingly) ────────────────────
LLM_PROVIDER=groq                       # groq | gemini
GROQ_API_KEY=gsk_your_groq_api_key      # Required if LLM_PROVIDER=groq
GEMINI_API_KEY=                         # Optional / if LLM_PROVIDER=gemini
LLM_MODEL=llama-3.3-70b-versatile       # Groq: llama-3.3-70b-versatile | Gemini: gemini-1.5-flash

# ── Database (Neon PostgreSQL recommended) ────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@ep-your-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Authentication & Security ────────────────────────────────────────────────
SERVICE_API_KEY=your_secure_32char_api_key      # Required header (X-API-Key) for /tickets endpoints
HUMAN_JWT_SECRET=your_secure_64char_jwt_secret   # Shared secret for signing human review JWTs
HUMAN_JWT_TOKEN=                                 # Optional pre-generated token for local testing
CORS_ORIGINS=http://localhost:8501,https://*.onrender.com

# ── Frontend UI Configuration ────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000               # Backend URL accessed by Streamlit

# ── Policy (server-enforced — never controlled by LLM) ───────────────────────
REFUND_CAP_CENTS=100000                  # Maximum auto-approved refund in paise (₹1000.00)
MAX_TOOL_CALLS_PER_TICKET=5             # Hard loop ceiling per ticket
MAX_REFUNDS_PER_TICKET=1                # Maximum refund side-effect per ticket

# ── n8n Outbound Notifications ───────────────────────────────────────────────
# n8n receives one outbound notification POST when notify_customer executes
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/delegate-notify
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret

# ── Cognee Memory (Optional) ─────────────────────────────────────────────────
# Leave blank to gracefully degrade (in-memory mock / no recall error)
COGNEE_LLM_PROVIDER=groq
COGNEE_LLM_API_KEY=
COGNEE_LLM_MODEL=openai/gpt-oss-120b

# ── Environment & Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development                  # development | staging | production
